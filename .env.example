# Copy this to .env and fill in real values. Never commit .env itself.

# --- Database ---------------------------------------------------------------
# Local: postgresql+asyncpg://USER:PASSWORD@localhost:5432/petroeye
# Neon: `neon env pull` writes both URLs; paste them as given (sslmode/channel_binding are handled).
#   DATABASE_URL          = pooled (-pooler host) — app traffic
#   DATABASE_URL_UNPOOLED = direct — used only by Alembic migrations
DATABASE_URL=postgresql+asyncpg://postgres:your_password_here@localhost:5432/petroeye
DATABASE_URL_UNPOOLED=

# --- MQTT broker ------------------------------------------------------------
# Local Mosquitto: localhost / 1883 / MQTT_TLS=false
# EMQX Cloud Serverless: <deployment>.<region>.emqxsl.com / 8883 / MQTT_TLS=true + credentials
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=
# Must be unique per running backend instance (two instances with the same
# ID keep kicking each other off the broker).
MQTT_CLIENT_ID=petrotwin-backend

# --- HTTP -------------------------------------------------------------------
# Comma-separated dashboard origins, e.g. http://localhost:3000,https://petroeye.vercel.app
CORS_ORIGINS=http://localhost:3000
# Extra origins allowed by regex (default: the PetroEye Vercel app + its preview deploys).
# Leave unset for the default; set to an empty value to disable.
# CORS_ORIGIN_REGEX=https://petroeye-frontend(-[a-z0-9-]+)?\.vercel\.app

# --- Auth -------------------------------------------------------------------
# Long random string; tokens signed with it. Changing it logs everyone out.
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_MINUTES=720
# First admin, created on startup only when there are no users yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Fleet behaviour --------------------------------------------------------
# true: unknown trucks are registered on their first MQTT message (simulator-friendly).
# false: only trucks registered via POST /trucks are accepted.
AUTO_REGISTER_TRUCKS=true
OFFLINE_AFTER_SECONDS=120
MOVING_SPEED_KMH=3
